### Windows
# Windows thumbnail cache files
Thumbs.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

# Generated local training data, audits and run outputs
/runs/
/training/audit_original/
/training/source_metadata/
/training/*.local.yaml
/training/*.log
/training/__pycache__/
/data/runtime/session.key

# Local environments, generated bytecode and developer tools
venv/
.venv/
node_modules/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
/data/maintenance/
/data/runtime/
/training/self_recorded_audit/
/training/self_recorded_detail_audit/

# Local application state and imported database backups
/data/*.db
/data/*.db-*
/data/*.log
/data/*.lock
/data/imports/
/data/alerts/*
!/data/alerts/.gitkeep
/data/videos/*.detections.json
